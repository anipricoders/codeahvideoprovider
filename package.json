{
  "name": "codeah-video-previewer",
  "version": "1.0.0",
  "description": "Secure video preview platform for CodeAH",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev:server": "mvnw.cmd spring-boot:run",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
